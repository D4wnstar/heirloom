{
	"name": "wiki-generator-template",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"preprocess": "ts-node scripts/clone-repo.ts && ts-node scripts/make-manifest.ts",
		"build": "npm run preprocess && vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^3.0.0-next.9",
		"@skeletonlabs/skeleton-svelte": "^1.0.0-next.15",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-vercel": "^6.3.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/typography": "0.5.10",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsdom": "^21.1.7",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^25.2.2",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"postcss": "^8.4.49",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"rehype-katex": "^7.0.1",
		"rehype-mermaid": "^3.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.9",
		"ts-node": "^10.9.2",
		"typescript": "^5.5.0",
		"unified": "^11.0.5",
		"vercel": "^50.13.2",
		"vfile-matter": "^5.0.1",
		"vite": "^5.4.4",
		"vitest": "^0.32.2"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "1.5.3",
		"@libsql/client": "^0.14.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"bcryptjs": "^2.4.3",
		"drizzle-orm": "^0.38.2",
		"github-slugger": "^2.0.0",
		"jsdom": "^26.1.0",
		"jsonwebtoken": "^9.0.2",
		"lucide-svelte": "^0.468.0"
	}
}
