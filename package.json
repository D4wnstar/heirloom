{
    "name": "heirloom",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "preprocess": "svelte-kit sync && ts-node scripts/clone-assets.ts && ts-node scripts/make-manifest.ts && ts-node scripts/move-media.ts",
        "preprocess:cached": "HEIRLOOM_USE_CACHED_ASSETS=1 npm run preprocess",
        "build": "npm run preprocess && vite build",
        "build:cached": "HEIRLOOM_USE_CACHED_ASSETS=1 npm run build",
        "preview": "vite preview",
        "test": "vitest",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@skeletonlabs/skeleton": "^5.0.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.50.2",
        "@sveltejs/vite-plugin-svelte": "^4.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/hast": "^3.0.4",
        "@types/mdast": "^4.0.4",
        "@types/node": "^25.2.2",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.66.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.9.0",
        "hast-util-from-html": "^2.0.3",
        "hast-util-to-html": "^9.0.5",
        "micromark": "^4.0.2",
        "micromark-util-character": "^2.1.1",
        "micromark-util-symbol": "^2.0.1",
        "micromark-util-types": "^2.0.2",
        "prettier": "^3.1.1",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rehype-external-links": "^3.0.0",
        "rehype-katex": "^7.0.1",
        "rehype-prism-plus": "^2.0.2",
        "rehype-stringify": "^10.0.1",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vfile-matter": "^5.0.1",
        "vite": "^5.4.4",
        "vitest": "^0.32.2"
    },
    "dependencies": {
        "@skeletonlabs/skeleton-svelte": "^5.0.0",
        "lucide-svelte": "^0.468.0"
    },
    "type": "module"
}
